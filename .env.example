# Copy to `.env` and adjust. Every value here overrides the matching key in
# configs/<MLC_ENV>.yaml. Nested keys use a double underscore as separator.
#
#   cp .env.example .env

# Which file under configs/ to load: development | production
MLC_ENV=development

# Global reproducibility seed (propagated to numpy, torch and the splitter).
MLC_SEED=42

# ── Data ─────────────────────────────────────────────────────────────────
# Relative paths are resolved against the repository root.
MLC_DATA__RAW_DIR=Data
MLC_DATA__MANIFEST_PATH=artifacts/manifest.csv

# ── Model ────────────────────────────────────────────────────────────────
MLC_MODEL__BACKBONE=resnet50
MLC_MODEL__PRETRAINED=true

# ── Training ─────────────────────────────────────────────────────────────
MLC_TRAINING__EPOCHS=25
MLC_TRAINING__BATCH_SIZE=32
MLC_TRAINING__LEARNING_RATE=3e-4
# cuda | cpu | mps | auto
MLC_TRAINING__DEVICE=auto
MLC_TRAINING__CHECKPOINT_DIR=artifacts/checkpoints

# ── Serving: API + Streamlit UI ──────────────────────────────────────────
MLC_SERVING__CHECKPOINT_PATH=artifacts/checkpoints/best.pt
MLC_SERVING__HOST=127.0.0.1
MLC_SERVING__PORT=8000
# Flag predictions below this confidence for manual review.
MLC_SERVING__REVIEW_THRESHOLD=0.70
# Report "unable to classify" rather than naming a species below this.
MLC_SERVING__UNKNOWN_THRESHOLD=0.30
# Where the Streamlit UI looks for the API.
MLC_SERVING__API_BASE_URL=http://127.0.0.1:8000
